{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "schedule": [
    "* 0-8 * * 6"
  ],
  "automerge": true,
  "automergeStrategy": "squash",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-8 * * 6"
    ]
  }
}
